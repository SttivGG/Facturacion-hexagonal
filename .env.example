# Copiar a .env y cambiar estas contraseñas de ejemplo antes de iniciar.
# Los hosts son los nombres DNS de los servicios dentro de Compose.
BACKEND_PORT=8080

MONGODB_HOST=facturacion-mongodb
MONGODB_DATABASE=facturacion_productos
MONGODB_USERNAME=facturacion_admin
MONGODB_PASSWORD=cambiar_mongo_solo_desarrollo

CASSANDRA_HOST=facturacion-cassandra
# Datacenter fijo: datacenter1. Sin autenticación en esta fase local.

MYSQL_HOST=facturacion-mysql
MYSQL_DATABASE=facturacion_ventas
MYSQL_USER=facturacion_app
MYSQL_PASSWORD=cambiar_mysql_solo_desarrollo
MYSQL_ROOT_PASSWORD=cambiar_root_solo_desarrollo

# Opcional: perfil analytics. PostgreSQL exclusivo para metadatos de Druid.
DRUID_PORT=8888
DRUID_ENABLED=false
# El Router se resuelve por DNS dentro de Docker; para Java fuera de Docker usar localhost.
DRUID_BASE_URL=http://druid-router:8888
DRUID_SYNC_INTERVAL=PT1M
DRUID_HTTP_TIMEOUT=PT10S
DRUID_TASK_TIMEOUT=PT8M
DRUID_MAX_REQUEST_BYTES=1000000
DRUID_METADATA_PASSWORD=cambiar_druid_solo_desarrollo

# Opcional: perfil ml. Python no publica puertos ni recibe credenciales MySQL.
ML_ENABLED=false
ML_DEMO_ENABLED=false
ML_BASE_URL=http://facturacion-ml:8000
ML_HTTP_TIMEOUT=PT10S
