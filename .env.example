# Copiar a .env y cambiar estas contraseñas de ejemplo antes de iniciar.
# Los hosts son los nombres DNS de los servicios dentro de Compose.
BACKEND_PORT=8080

MONGODB_HOST=facturacion-mongodb
MONGODB_DATABASE=facturacion_productos
MONGODB_USERNAME=facturacion_admin
MONGODB_PASSWORD=cambiar_mongo_solo_desarrollo

CASSANDRA_HOST=facturacion-cassandra
# Datacenter fijo: datacenter1. Sin autenticación en esta fase local.

MYSQL_HOST=facturacion-mysql
MYSQL_DATABASE=facturacion_ventas
MYSQL_USER=facturacion_app
MYSQL_PASSWORD=cambiar_mysql_solo_desarrollo
MYSQL_ROOT_PASSWORD=cambiar_root_solo_desarrollo
